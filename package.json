{
    "name": "vigil",
    "version": "0.1.0",
    "private": true,
    "description": "Self-hosted uptime monitoring with a public status page",
    "license": "MIT",
    "author": "alexalghisi",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "seed": "node scripts/seed-demo.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "node --test --test-concurrency=1 \"test/unit/*.test.js\" \"test/api/*.test.js\"",
        "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
        "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
    },
    "dependencies": {
        "cookie": "^1.0.1",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "mongodb": "^6.10.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.12.0",
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.5",
        "eslint": "^9.12.0",
        "globals": "^15.11.0",
        "playwright": "1.56.0",
        "typescript": "^5.6.3"
    }
}
